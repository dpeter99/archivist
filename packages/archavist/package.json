{
  "name": "@dpeter99/archavist",
  "version": "0.0.0-alpha2",
  "description": "static site gen",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpeter99/archivist.git"
  },
  "scripts": {
    "check": "tsc -b --noEmit",
    "build": "rolldown --config rolldown.config.ts && npm run copy-public",
    "copy-public": "node ./scripts/copy_public.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./template": "./dist/template.js"
  },
  "bin": {
    "archavist": "./dist/cli.js"
  },
  "dependencies": {
    "@flowershow/remark-wiki-link": "^3.2.1",
    "@vitejs/plugin-react": "5.1.1",
    "@vitejs/plugin-rsc": "0.5.1",
    "chokidar": "4.0.3",
    "commander": "14.0.2",
    "cosmiconfig": "9.0.0",
    "glob": "11.1.0",
    "gray-matter": "4.0.3",
    "ora": "9.0.0",
    "picocolors": "1.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.1",
    "rsc-html-stream": "^0.0.7",
    "serve-handler": "6.1.6",
    "unified": "11.0.5",
    "unist-util-visit": "^5.0.0",
