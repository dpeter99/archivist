  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rolldown/pluginutils": "1.0.0-beta.51",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@types/serve-handler": "6.1.4",
    "@types/mdast": "^4.0.4",
    "rolldown": "1.0.0-beta.51",
    "rolldown-plugin-dts": "0.18.0",
